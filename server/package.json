{
  "name": "@vms/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../.env src/server.ts",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../.env src/db/cli.ts seed",
    "db:reset": "tsx --env-file-if-exists=../.env src/db/cli.ts reset",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval:intake": "tsx --env-file-if-exists=../.env src/scripts/eval-intake.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@electric-sql/pglite": "^0.4.6",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "^0.34.0",
    "@vms/contracts": "*",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.0",
    "json-logic-js": "^2.0.5",
    "kysely": "^0.28.0",
    "kysely-pglite-dialect": "^1.3.1",
    "pg": "^8.16.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
