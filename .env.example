NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# Zero-setup embedded Postgres (stored in server/.data/pg). To use the local PostgreSQL 17 instead:
# DATABASE_URL=postgres://postgres:<password>@localhost:5432/vms
DATABASE_URL=pglite:./.data/pg

JWT_SECRET=change-me-in-local-env
FILES_DIR=./.data/files

# Fixed login code for development (no SMS/email yet). Must be empty in production.
DEV_OTP=123456

# How messages, screenshots and documents are read (smart intake, portal screenshots, evidence):
#   ocr    - free local OCR + rules (default, no key, nothing leaves this computer)
#   gemini - Google Gemini; free key from https://aistudio.google.com
#            FREE KEY = TEST DATA ONLY: Google may use free-tier inputs. Blur phone/licence numbers.
#   openrouter - any vision model through OpenRouter (one key, pay per use); set OPENROUTER_API_KEY
#            default model google/gemini-2.5-flash-lite: cheapest reliable one, about $0.001 per read
#   claude - Claude; set ANTHROPIC_API_KEY
#   off    - typed/pasted text only
AI_MODE=ocr
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_TIER=free
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
